---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import skillsmdRobot from '../../assets/skillsmd.png';
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime, type BlogPost } from '../../lib/posts';
import { withBase } from '../../lib/urls';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedTime = post.data.pubDate.toISOString();
const displayDate = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.pubDate);
---

<Base title={post.data.title} description={post.data.description} publishedTime={publishedTime} noindex={post.data.draft}>
  <article class="post">
    <header class="post-header">
      <a class="back-link" href={withBase('posts/')}><span aria-hidden="true">← </span>All writing</a>
      {post.data.draft && <p class="draft-label">Unpublished draft</p>}
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      {(post.data.aiDisclosure || post.data.humanWritten) && (
        <aside class="authorship-disclosure" aria-label="Article authorship">
          <Image class="authorship-disclosure-logo" src={skillsmdRobot} alt="" width={56} height={56} loading="eager" />
          <div>
            <p class="authorship-disclosure-title">{post.data.humanWritten ? 'Entirely human-written' : 'AI-written / AI-edited'}</p>
            {post.data.humanWritten ? (
              <p>This writeup was written without AI-generated or AI-edited prose.</p>
            ) : (
              <p>{post.data.aiDisclosure}</p>
            )}
          </div>
        </aside>
      )}
      <p class="post-meta">
        <time datetime={publishedTime}>{displayDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)} min read</span>
      </p>
    </header>
    <div class="prose"><Content /></div>
    <footer class="post-footer">
      <a class="back-link" href={withBase('posts/')}><span aria-hidden="true">← </span>Back to writing</a>
    </footer>
  </article>
</Base>
