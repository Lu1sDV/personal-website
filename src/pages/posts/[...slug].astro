---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime, type BlogPost } from '../../lib/posts';
import { withBase } from '../../lib/urls';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedTime = post.data.pubDate.toISOString();
const displayDate = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.pubDate);
---

<Base title={post.data.title} description={post.data.description} publishedTime={publishedTime} noindex={post.data.draft}>
  <article class="post">
    <header class="post-header">
      <a class="back-link" href={withBase('posts/')}><span aria-hidden="true">← </span>All writing</a>
      {post.data.draft && <p class="draft-label">Unpublished draft</p>}
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="post-meta">
        <time datetime={publishedTime}>{displayDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)} min read</span>
      </p>
    </header>
    <div class="prose"><Content /></div>
    <footer class="post-footer">
      <a class="back-link" href={withBase('posts/')}><span aria-hidden="true">← </span>Back to writing</a>
    </footer>
  </article>
</Base>
