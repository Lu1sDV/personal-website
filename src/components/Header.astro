---
import { site } from '../site';
import { withBase } from '../lib/urls';

const pathname = Astro.url.pathname;
const inWriting = pathname.startsWith(withBase('posts/'));
const inProjects = pathname.startsWith(withBase('projects/'));
---

<header class="site-header">
  <a class="site-mark" href={withBase()} aria-label={`${site.wordmark} home`}>
    <span>{site.wordmark}</span>
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    <a href={withBase()} aria-current={pathname === withBase() ? 'page' : undefined}>Dashboard</a>
    <a href={withBase('posts/')} aria-current={inWriting ? 'page' : undefined}>Blog</a>
    <a href={withBase('projects/')} aria-current={inProjects ? 'page' : undefined}>Projects</a>
    <a class="github-link" href="https://github.com/Lu1sDV" aria-label="GitHub" title="Lu1sDV on GitHub">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-4.3 1.3-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.2-1.5 6.2-6.9a5.4 5.4 0 0 0-1.5-3.7A5 5 0 0 0 18.7 1S17.5.7 15 2.5a13 13 0 0 0-6 0C6.5.7 5.3 1 5.3 1a5 5 0 0 0-.1 3.8 5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.2 6.6 6.2 6.9a3.4 3.4 0 0 0-.9 2.7V22" />
      </svg>
    </a>
    <button class="theme-toggle" type="button" aria-label="Switch color theme" hidden>
      <svg class="theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4L19 5" />
      </svg>
      <svg class="theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 13.1A8.5 8.5 0 0 1 10.9 3.5a8.5 8.5 0 1 0 9.6 9.6Z" />
      </svg>
    </button>
  </nav>
</header>
